# --- Secrets: never commit real credentials ---------------------------------
.env
.env.*
!.env.example

# --- Python / Django ---------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
*.sqlite3
staticfiles/

# --- Node / Vite (frontend/.gitignore covers the rest) -----------------------
node_modules/
dist/

# --- Local tool state (session logs may contain private notes) ---------------
.remember/

# --- Editors / OS ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
