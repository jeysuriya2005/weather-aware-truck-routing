# Copy to .env.local and adjust. Every VITE_* value is PUBLIC (bundled into
# the browser JavaScript). Never put API keys or secrets in this file.

# Base URL of the Django API. Leave unset in development to use the Vite
# proxy (/api -> http://127.0.0.1:8000). Set it for production builds, e.g.:
# VITE_API_BASE_URL=https://your-backend.example.com/api
VITE_API_BASE_URL=
