# Copy to backend/.env (git-ignored) and fill in. Never commit real values.

# Required. Generate one with:
#   .\.venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# True only for local development.
DJANGO_DEBUG=True

# Comma-separated hostnames this server answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed to call the API (production).
# Not needed locally: the Vite dev server proxies /api to Django.
CORS_ALLOWED_ORIGINS=

# Optional: comma-separated origin regexes, e.g. for Vercel preview deployments:
#   ^https://my-app-[a-z0-9-]+\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEXES=

# --- Production behind an HTTPS proxy (e.g. Render). Leave unset locally. ---
# Trust the proxy's X-Forwarded-Proto header (required before enabling the redirect).
DJANGO_BEHIND_HTTPS_PROXY=False
# Redirect plain HTTP to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
# HSTS max-age in seconds (start small, e.g. 3600; 0 = off).
DJANGO_SECURE_HSTS_SECONDS=0
# Proxies that append to X-Forwarded-For (throttle client identity). Unset = DRF default.
# DJANGO_NUM_PROXIES=1

# Required for geocoding and routes. TomTom Routing + Geocoding key, read only
# by Django; never sent to the browser. Create one at https://developer.tomtom.com/
# Note: an existing OS environment variable takes precedence over this file,
# so an empty $env:TOMTOM_API_KEY in your shell will hide the value here.
TOMTOM_API_KEY=
